# Copie para .env e ajuste os valores. O arquivo .env não é versionado.

# API
NODE_ENV=development
PORT=3000
API_PORT=3000

# Banco de dados (usado pelo docker-compose)
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=studyhub
DB_PORT=5432

# Conexão usada pela API quando executada fora do Docker (npm run dev)
DATABASE_URL=postgres://studyhub:troque-esta-senha@localhost:5432/studyhub
